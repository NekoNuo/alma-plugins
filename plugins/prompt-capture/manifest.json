{
    "id": "prompt-capture",
    "name": "Prompt Capture",
    "version": "1.0.0",
    "description": "Captures and displays complete prompts sent to AI, with export capability",
    "author": {
        "name": "Alma Team"
    },
    "main": "main.js",
    "engines": {
        "alma": "^0.1.0"
    },
    "type": "ui",
    "activationEvents": ["onStartup"],
    "permissions": ["chat:read", "notifications"],
    "contributes": {
        "commands": [
            {
                "id": "promptCapture.toggle",
                "title": "Toggle Prompt Capture"
            },
            {
                "id": "promptCapture.showHistory",
                "title": "Show Captured Prompts"
            },
            {
                "id": "promptCapture.clearHistory",
                "title": "Clear Captured Prompts"
            },
            {
                "id": "promptCapture.exportHistory",
                "title": "Export Captured Prompts"
            }
        ],
        "configuration": {
            "title": "Prompt Capture",
            "properties": {
                "promptCapture.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Enable prompt capturing"
                },
                "promptCapture.captureResponses": {
                    "type": "boolean",
                    "default": true,
                    "description": "Also capture AI responses"
                },
                "promptCapture.maxHistory": {
                    "type": "number",
                    "default": 100,
                    "description": "Maximum number of prompts to keep in history"
                },
                "promptCapture.logToConsole": {
                    "type": "boolean",
                    "default": true,
                    "description": "Log captured prompts to console"
                }
            }
        }
    }
}
