{
    "id": "provider-format-display",
    "name": "Provider Format Display",
    "version": "1.0.0",
    "description": "在状态栏显示当前 Provider 和 API Format，支持实时更新",
    "author": {
        "name": "Alma Team",
        "email": "hello@alma.now"
    },
    "main": "main.js",
    "engines": {
        "alma": "^0.1.0"
    },
    "type": "ui",
    "permissions": ["chat:read"],
    "activationEvents": ["onStartup"],
    "contributes": {
        "components": {
            "statusBar": [
                {
                    "id": "provider-format-display.statusBar",
                    "alignment": "right",
                    "priority": 90
                }
            ]
        },
        "configuration": {
            "title": "Provider Format Display",
            "properties": {
                "providerFormatDisplay.showFormat": {
                    "type": "boolean",
                    "default": true,
                    "description": "显示 API Format 信息"
                },
                "providerFormatDisplay.showProvider": {
                    "type": "boolean",
                    "default": true,
                    "description": "显示 Provider 名称"
                }
            }
        }
    }
}
