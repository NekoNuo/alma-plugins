{
    "id": "api-format-switcher",
    "name": "API Format Switcher",
    "version": "1.0.0",
    "description": "Display and switch API format (messages, chat/completions, responses) in the status bar",
    "author": {
        "name": "Alma Team",
        "email": "hello@alma.now"
    },
    "main": "main.js",
    "engines": {
        "alma": "^0.1.0"
    },
    "type": "ui",
    "permissions": ["settings:read", "settings:write"],
    "activationEvents": ["onStartup"],
    "contributes": {
        "commands": [
            {
                "id": "apiFormat.switch",
                "title": "Switch API Format"
            },
            {
                "id": "apiFormat.addCustom",
                "title": "Add Custom API Format"
            }
        ],
        "components": {
            "statusBar": [
                {
                    "id": "api-format-switcher.statusBar",
                    "alignment": "right",
                    "priority": 90
                }
            ]
        },
        "configuration": {
            "title": "API Format Switcher",
            "properties": {
                "apiFormat.current": {
                    "type": "string",
                    "default": "chat/completions",
                    "description": "Current API format"
                },
                "apiFormat.customFormats": {
                    "type": "array",
                    "default": [],
                    "description": "Custom API formats added by the user"
                }
            }
        }
    }
}

